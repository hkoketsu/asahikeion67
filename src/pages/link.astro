---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { getAssetPath } from '../utils/paths.js';
const base = import.meta.env.BASE_URL || '';
---


<BaseLayout title="LINK - 旭丘軽音楽部">
  <main class="main-content">
    <div class="link-header">
      <img src={getAssetPath("/archived/_ppic_/275/9947f7.jpg")} alt="LINK" class="link-logo" />
      <img src={getAssetPath("/archived/_ppic_/870/51f659.gif")} alt="装飾" class="link-decoration" />
    </div>
    
    <div class="link-content">
      <div class="link-section">
        <div class="links">
          <a href="http://22.xmbs.jp/asahi66keion/?guid=on" class="link-item" target="_blank">
            <img src={getAssetPath("/archived/_ppic_/220/ae2b70.gif")} alt="リンクアイコン" class="link-icon" />
            <span class="link-text">ろくろく軽音部</span>
          </a>
          
          <a href="http://70.xmbs.jp/asahi65keion/?guid=on" class="link-item" target="_blank">
            <img src={getAssetPath("/archived/_ppic_/220/ae2b70.gif")} alt="リンクアイコン" class="link-icon" />
            <span class="link-text">ろくご軽音部</span>
          </a>
          
          <a href="http://26.xmbs.jp/asahikeion68/" class="link-item" target="_blank">
            <img src={getAssetPath("/archived/_ppic_/220/ae2b70.gif")} alt="リンクアイコン" class="link-icon" />
            <span class="link-text">ろくはち軽音部</span>
          </a>
          
          <a href="http://17.xmbs.jp/asahi67hand/" class="link-item" target="_blank">
            <img src={getAssetPath("/archived/_ppic_/220/ae2b70.gif")} alt="リンクアイコン" class="link-icon" />
            <span class="link-text">ろくなな演劇部</span>
          </a>
        </div>
      </div>
      
      <div class="link-nav">
        <span class="nav-info">(1/1)</span>
        <div class="nav-links">
          <a href="#">前</a> | 
          <a href="#">次</a> | 
          <a href="#">最初</a> | 
          <a href="#">最新</a>
        </div>
      </div>
    </div>
    
    <nav class="navigation">
      <a href={`${base}`}>ホームに戻る</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .link-header {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .link-logo {
    max-height: 100px;
    width: auto;
  }

  .link-decoration {
    max-height: 60px;
    width: auto;
  }
  
  .link-content {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
    background: #ffffff;
    border-radius: 8px;
  }
  
  .link-section {
    margin: 2rem 0;
  }
  
  .links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .link-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    text-decoration: none;
    color: #808080;
    transition: all 0.3s;
  }
  
  .link-item:hover {
    background: #fff;
    border-color: #808080;
    transform: translateX(10px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  .link-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  
  .link-text {
    flex: 1;
    font-size: 1rem;
    margin-left: 2rem;
  }

  .link-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e0e0e0;
    text-align: center;
  }

  .nav-info {
    display: block;
    color: #999;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .nav-links {
    color: #808080;
  }

  .nav-links a {
    color: #808080;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    transition: all 0.2s;
  }

  .nav-links a:hover {
    color: #333;
    text-decoration: underline;
  }
  
  .navigation {
    margin-top: 3rem;
    text-align: center;
  }
  
  .navigation a {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: #fff;
    color: #333;
    text-decoration: none;
    border: 2px solid #808080;
    border-radius: 25px;
    transition: all 0.3s;
  }
  
  .navigation a:hover {
    background: #808080;
    color: white;
  }
  
  @media (max-width: 768px) {
    .link-header {
      flex-direction: column;
    }

    .link-content {
      padding: 1rem;
    }
  }
</style>