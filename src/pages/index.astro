      </div>
      <div class="nav-item real">
        <span>◆</span><a href="/real">REAL</a>
        <a href="/real-archive">(過)</a>
      </div>
      <div class="nav-item photo">
        <span>◆</span><a href="/photo">PHOTO</a>
      </div>
      <div class="nav-item song">
        <span>◆</span><a href="/song">SONG</a>
      </div>
      <div class="nav-item link">
        <span>◆</span><a href="/link">LINK</a>
