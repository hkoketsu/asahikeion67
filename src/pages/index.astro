---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { getAssetPath } from '../utils/paths.js';
const base = import.meta.env.BASE_URL || '/';
---


<BaseLayout title="旭丘軽音楽部">
  <main class="main-content">
    <p class="site-title">旭丘軽音67期</p>

    <img src={getAssetPath("/images/666/5b60db.jpg")} alt="メイン画像" class="hero-image" />

    <div class="decorative-images">
      <img src={getAssetPath("/images/189/13ffd8.gif")} alt="装飾" />
      <img src={getAssetPath("/images/848/7cb3e6.gif")} alt="装飾" />
      <img src={getAssetPath("/images/189/13ffd8.gif")} alt="装飾" />
      <img src={getAssetPath("/images/629/1fa16a.gif")} alt="装飾" />
      <img src={getAssetPath("/images/189/13ffd8.gif")} alt="装飾" />
    </div>

    <nav class="nav-menu">
      <div class="nav-item profile">
        <span>◆</span><a href={`${base}profile`}>PROF</a>
      </div>
      <div class="nav-item diary">
        <span>◆</span><a href={`${base}diary`}>DIARY</a>
      </div>
      <div class="nav-item real">
        <span>◆</span><a href={`${base}real`}>REAL</a>
        <a href={`${base}real-archive`}>(過)</a>
      </div>
      <div class="nav-item photo">
        <span>◆</span><a href={`${base}photo`}>PHOTO</a>
      </div>
      <div class="nav-item song">
        <span>◆</span><a href={`${base}song`}>SONG</a>
      </div>
      <div class="nav-item link">
        <span>◆</span><a href={`${base}link`}>LINK</a>
      </div>
    </nav>

    <div class="banner-image">
      <a href={`${base}real`}>
        <img src={getAssetPath("/images/bb/5/asahi67keion_30185.gif")} alt="バナー" />
      </a>
    </div>

  </main>

  <footer class="site-footer">
    <a href="http://m-space.jp/">mobile space</a>
  </footer>
</BaseLayout>
