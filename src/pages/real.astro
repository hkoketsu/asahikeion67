---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="REAL - 旭部軽音楽部">
  <main class="main-content">
    <div class="real-header">
      <h1>REAL (リアルタイム掲示板)</h1>
      <div class="real-controls">
        <a href="#" class="control-icon">✏️</a>
        <a href="#" class="control-icon">📧</a>
      </div>
    </div>
    
    <div class="real-board">
      <div class="board-message">
        <p class="ascii-art">m r m r m r m</p>
      </div>
      
      <div class="board-content">
        <p class="board-description">
          リアルタイム掲示板へようこそ！<br/>
          ここでは旭部軽音楽部のメンバーが自由に交流できます。
        </p>
        
        <div class="board-styles">
          <pre class="css-display">
body {
  font-family:"Verdana","メイリオ","ＭＳＰゴシック";
  letter-spacing: ;
  font-size: 65%;
  line-height: 2em;
  cursor:default;}
          </pre>
        </div>
        
        <div class="board-info">
          <p>スクロールバーのカスタマイズや、リンクスタイルなど、<br/>
          オリジナルのデザインを保持しています。</p>
        </div>
      </div>
    </div>
    
    <nav class="navigation">
      <a href="/">ホームに戻る</a>
      <a href="#">過去ログを見る</a>
      <a href="#">月別アーカイブ</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .real-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #ddd;
  }
  
  .real-header h1 {
    color: #333;
    font-size: 1.8rem;
  }
  
  .real-controls {
    display: flex;
    gap: 1rem;
  }
  
  .control-icon {
    font-size: 1.5rem;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  
  .control-icon:hover {
    opacity: 1;
  }
  
  .real-board {
    padding: 2rem;
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
    margin: 2rem 0;
  }
  
  .board-message {
    text-align: right;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px dotted #ccc;
  }
  
  .ascii-art {
    font-family: monospace;
    color: #999;
    font-size: 0.9rem;
    letter-spacing: 0.5em;
  }
  
  .board-content {
    padding: 1rem 0;
  }
  
  .board-description {
    color: #666;
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  
  .board-styles {
    background: #f9f9f9;
    padding: 1rem;
    border-radius: 4px;
    margin: 1rem 0;
  }
  
  .css-display {
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    color: #555;
    line-height: 1.6;
    overflow-x: auto;
  }
  
  .board-info {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dotted #ddd;
    color: #777;
    font-size: 0.95rem;
  }
  
  .navigation {
    margin-top: 2rem;
    text-align: center;
    display: flex;
    gap: 2rem;
    justify-content: center;
  }
  
  .navigation a {
    color: #666;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    transition: all 0.2s;
  }
  
  .navigation a:hover {
    background: #f0f0f0;
    border-color: #999;
  }
</style>