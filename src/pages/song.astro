<style>
  h1 {
    text-align: center;
    color: #333;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ff8c94;
  }
  
  .bands-container {
    display: grid;
    gap: 3rem;
  }
  
  .band-section {
    background: #fff;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  .band-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f0f0f0;
  }
  
  .band-logo {
    width: 150px;
    height: auto;
    max-height: 100px;
    object-fit: contain;
    border-radius: 8px;
  }
  
  .song-list {
    display: grid;
    gap: 0.5rem;
  }
  
  .song-item {
    display: flex;
    align-items: center;
    padding: 0.8rem 1rem;
    background: #f9f9f9;
    border-radius: 6px;
    transition: all 0.2s;
  }
  
  .song-item:hover {
    background: #ff8c94;
    color: white;
    transform: translateX(5px);
  }
  
  .song-number {
    color: #ff8c94;
    font-weight: bold;
    margin-right: 1rem;
    font-family: monospace;
    min-width: 40px;
  }
  
  .song-item:hover .song-number {
    color: white;
  }
  
  .song-title {
    flex: 1;
    color: #333;
  }
  
  .song-item:hover .song-title {
    color: white;
  }
  
  .navigation {
    margin-top: 3rem;
    text-align: center;
  }
  
  .navigation a {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: #fff;
    color: #333;
    text-decoration: none;
    border: 2px solid #ff8c94;
    border-radius: 25px;
    transition: all 0.3s;
  }
  
  .navigation a:hover {
    background: #ff8c94;
    color: white;
  }
  
  @media (max-width: 768px) {
    .band-header {
      flex-direction: column;
      text-align: center;
    }
    
    .song-item {
      flex-direction: column;
      text-align: center;
    }
    
    .song-number {
      margin-right: 0;
      margin-bottom: 0.5rem;
    }
  }
</style>