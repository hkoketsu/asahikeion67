<style>
  h1 {
    text-align: center;
    color: #ff0000;
    background: #000;
    padding: 1rem;
    margin: -2rem -2rem 2rem -2rem;
    font-family: 'Impact', sans-serif;
    letter-spacing: 2px;
  }
  
  .song-list {
    background: #000;
    color: #ff0000;
    padding: 2rem;
    border-radius: 8px;
    margin: 2rem 0;
  }
  
  .song-list h2 {
    text-align: center;
    color: #fff;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ff0000;
  }
  
  .songs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .song-item {
    display: flex;
    align-items: center;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    transition: all 0.2s;
  }
  
  .song-item:hover {
    background: rgba(255, 0, 0, 0.1);
    transform: translateX(5px);
  }
  
  .song-number {
    color: #ff0033;
    font-weight: bold;
    margin-right: 1rem;
    font-family: monospace;
    min-width: 40px;
  }
  
  .song-link {
    color: #ffffff;
    text-decoration: none;
    flex: 1;
  }
  
  .song-link:hover {
    color: #ff0033;
    text-decoration: underline;
  }
  
  .song-pages {
    text-align: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #ff0000;
    color: #fff;
  }
  
  .song-pages a {
    color: #ff0033;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #ff0033;
    border-radius: 4px;
    margin-left: 1rem;
  }
  
  .song-pages a:hover {
    background: #ff0033;
    color: #000;
  }
  
  .navigation {
    margin-top: 2rem;
    text-align: center;
  }
  
  .navigation a {
    color: #666;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    display: inline-block;
  }
  
  .navigation a:hover {
    background: #f0f0f0;
    border-color: #999;
  }
</style>